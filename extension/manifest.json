{
  "manifest_version": 3,
  "name": "Plannotate",
  "version": "0.2.3",
  "description": "Review versioned HTML plans directly in GitHub pull requests.",
  "homepage_url": "https://github.com/ingtshan/Plannotate",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Plannotate"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html", "viewer.css", "viewer.js", "protocol.js", "github.js",
        "sandbox.html", "sandbox.css", "sandbox.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ],
  "options_page": "options.html",
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
